# Optional legacy contact address retained for legal/contact pages.
VITE_SALES_EMAIL=hello@yourfriend.online

# Enables the live WebGL VRM after the poster loads.
# The showcase defaults to the CC0 AvatarSample A model shipped by
# https://github.com/ruslanmv/3D-Avatar-Chatbot
VITE_ENABLE_LIVE_VRM=true

# Public open-source application/demo.
VITE_APP_URL=https://ruslanmv.github.io/3D-Avatar-Chatbot/
